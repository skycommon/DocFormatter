# Normalize line endings on commit (keeps repo LF; Windows tooling can still read)
* text=auto eol=lf

# Explicit overrides
*.bat        text eol=crlf
*.cmd        text eol=crlf
*.ps1        text eol=crlf
*.py         text eol=lf
*.spec       text eol=lf
*.md         text eol=lf
*.yml        text eol=lf
*.yaml       text eol=lf
*.json       text eol=lf
*.toml       text eol=lf
*.ico        binary
*.png        binary
*.jpg        binary
*.jpeg       binary
*.gif        binary
*.docx       binary
*.pdf        binary